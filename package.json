{
  "name": "sawstop-finger-save",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Minimal local harness for SawStop Finger Save verification scripts.",
  "scripts": {
    "check:notion-schema": "node --experimental-strip-types scripts/check-notion-schema.ts",
    "check:allowed-values": "node --experimental-strip-types scripts/check-allowed-values.ts",
    "check:attachment-source-live": "node --experimental-strip-types scripts/check-attachment-source-live.ts",
    "check:fifo-trash-candidates": "node --experimental-strip-types scripts/check-fifo-trash-candidates.ts",
    "check:queue-payload-fixtures": "node scripts/check-queue-payload-fixtures.js",
    "check:submit-fixtures": "node scripts/check-submit-fixtures.js",
    "check:submit-no-default-report-body": "node scripts/check-submit-no-default-report-body.js",
    "check:submit-validation-contract": "node scripts/check-submit-validation-contract.js",
    "check:submit-attachment-contract": "node scripts/check-submit-attachment-contract.js",
    "check:customer-form-required-contract": "node scripts/check-customer-form-required-contract.js",
    "check:customer-input-validation-contract": "node --experimental-strip-types scripts/check-customer-input-validation-contract.ts",
    "check:customer-attachment-ux-contract": "node scripts/check-customer-attachment-ux-contract.js",
    "check:customer-form-review-contract": "node --experimental-strip-types scripts/check-customer-form-review-contract.ts",
    "check:customer-layout-stability-contract": "node scripts/check-customer-layout-stability-contract.js",
    "check:customer-click-layout-stability": "node scripts/check-customer-click-layout-stability.mjs",
    "check:customer-turnstile-contract": "node scripts/check-customer-turnstile-contract.js",
    "check:default-accident-page-body-fixture": "node --experimental-strip-types scripts/check-default-accident-page-body-fixture.ts",
    "check:output-route-contract": "node scripts/check-output-route-contract.js",
    "check:admin-upload-ux-contract": "node scripts/check-admin-upload-ux-contract.js",
    "check:admin-upload-auth-contract": "node scripts/check-admin-upload-auth-contract.js",
    "check:live-verification-packet-contract": "node scripts/check-live-verification-packet-contract.js",
    "smoke:submit": "node --experimental-strip-types scripts/smoke-submit.ts",
    "smoke:admin-search": "node --experimental-strip-types scripts/smoke-admin-search.ts",
    "smoke:admin-upload": "node --experimental-strip-types scripts/smoke-admin-upload.ts",
    "smoke:admin-list-attachments": "node --experimental-strip-types scripts/smoke-admin-list-attachments.ts",
    "smoke:admin-update-accident-status": "node --experimental-strip-types scripts/smoke-admin-update-accident-status.ts",
    "smoke:admin-move-attachment-to-trash": "node --experimental-strip-types scripts/smoke-admin-move-attachment-to-trash.ts",
    "smoke:admin-process-fifo-trash": "node --experimental-strip-types scripts/smoke-admin-process-fifo-trash.ts",
    "smoke:admin-restore-attachment": "node --experimental-strip-types scripts/smoke-admin-restore-attachment.ts",
    "smoke:admin-update-attachment-type": "node --experimental-strip-types scripts/smoke-admin-update-attachment-type.ts",
    "parity:run": "node --experimental-strip-types scripts/run-harness-scenarios.ts",
    "parity:compare": "node --experimental-strip-types scripts/compare-harness-results.ts",
    "parity": "npm run parity:run && npm run parity:compare",
    "ci": "npm run test",
    "deploy:ci": "npx wrangler deploy",
    "dev:local": "npx wrangler dev",
    "dev:fully-local": "npx wrangler dev --local",
    "dev:remote": "npx wrangler dev --remote",
    "dev:recalculate-finger-photo": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/recalculate-finger-photo.ts",
    "test": "npm run check:notion-schema && npm run check:allowed-values && npm run check:submit-no-default-report-body && npm run smoke:submit && npm run smoke:admin-search && npm run smoke:admin-upload && npm run smoke:admin-list-attachments && npm run smoke:admin-update-accident-status && npm run smoke:admin-update-attachment-type && npm run smoke:admin-move-attachment-to-trash && npm run smoke:admin-restore-attachment && npm run smoke:admin-process-fifo-trash",
    "lint": "node --check scripts/verify-gates.js",
    "verify:gates": "node scripts/verify-gates.js --status",
    "cleanup:fifo-trash:dry-run": "node --experimental-strip-types scripts/fifo-cleanup-dry-run.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.6.0",
    "wrangler": "^4.81.1"
  }
}
